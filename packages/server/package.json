{
  "name": "@portaidentity/server",
  "version": "1.17.0",
  "description": "Multi-tenant OIDC provider built on node-oidc-provider, Koa, and TypeScript",
  "type": "module",
  "license": "MIT",
  "bin": {
    "porta-server": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "locales",
    "migrations",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "../../node_modules/@typescript/native/bin/tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "pnpm run test:all",
    "test:all": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e && pnpm run test:pentest",
    "test:changed": "vitest run --changed=origin/develop --project unit",
    "test:changed:integration": "vitest run --changed=origin/develop --project integration",
    "test:watch": "vitest --project unit",
    "test:watch:integration": "vitest --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:pentest": "vitest run --project pentest",
    "test:ui": "playwright test --config tests/ui/playwright.config.ts",
    "test:ui:debug": "playwright test --config tests/ui/playwright.config.ts --headed --workers=1",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "typecheck": "../../node_modules/@typescript/native/bin/tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test:all && pnpm run build",
    "migrate": "node-pg-migrate up --migrations-dir migrations --migration-file-language sql",
    "migrate:rollback": "node-pg-migrate down --migrations-dir migrations --migration-file-language sql --count 1",
    "migrate:status": "node-pg-migrate status --migrations-dir migrations --migration-file-language sql",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "porta": "tsx src/cli/index.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@koa/router": "15.7.1",
    "argon2": "0.45.2",
    "chalk": "6.0.1",
    "cli-table3": "0.6.5",
    "dotenv": "18.0.10",
    "handlebars": "4.7.10",
    "i18next": "27.0.1",
    "i18next-fs-backend": "2.6.10",
    "ioredis": "6.0.0",
    "jose": "6.2.17",
    "koa": "3.3.0",
    "koa-bodyparser": "4.4.1",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.4.0",
    "oidc-provider": "9.13.3",
    "open": "11.0.4",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "prom-client": "^15",
    "qrcode": "1.5.4",
    "yaml": "2.9.1",
    "yargs": "18.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/koa": "3.0.3",
    "@types/koa-bodyparser": "4.3.13",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/oidc-provider": "9.13.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/yargs": "17.0.35",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blendsdk/porta-identity.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
