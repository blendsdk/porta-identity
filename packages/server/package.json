{
  "name": "@portaidentity/server",
  "version": "1.7.3",
  "description": "Multi-tenant OIDC provider built on node-oidc-provider, Koa, and TypeScript",
  "type": "module",
  "license": "MIT",
  "bin": {
    "porta-server": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "locales",
    "migrations",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "../../node_modules/@typescript/native/bin/tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --project unit --project integration",
    "test:all": "yarn test:unit && yarn test:integration && yarn test:e2e && yarn test:pentest",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:pentest": "vitest run --project pentest",
    "test:ui": "playwright test --config tests/ui/playwright.config.ts",
    "test:ui:debug": "playwright test --config tests/ui/playwright.config.ts --headed --workers=1",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "typecheck": "../../node_modules/@typescript/native/bin/tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "verify": "yarn lint && yarn typecheck && yarn test:all && yarn build",
    "migrate": "node-pg-migrate up --migrations-dir migrations --migration-file-language sql",
    "migrate:rollback": "node-pg-migrate down --migrations-dir migrations --migration-file-language sql --count 1",
    "migrate:status": "node-pg-migrate status --migrations-dir migrations --migration-file-language sql",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "porta": "tsx src/cli/index.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@koa/router": "15.7.0",
    "argon2": "0.45.1",
    "chalk": "6.0.0",
    "cli-table3": "0.6.5",
    "dotenv": "17.4.2",
    "handlebars": "4.7.9",
    "i18next": "26.4.0",
    "i18next-fs-backend": "2.6.7",
    "ioredis": "6.0.0",
    "jose": "6.2.10",
    "koa": "3.2.1",
    "koa-bodyparser": "4.4.1",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "9.0.5",
    "oidc-provider": "9.11.4",
    "open": "11.0.1",
    "otpauth": "9.5.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prom-client": "^15",
    "qrcode": "1.5.4",
    "yaml": "2.9.0",
    "yargs": "18.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/koa": "3.0.3",
    "@types/koa-bodyparser": "4.3.13",
    "@types/koa__router": "12.0.5",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/oidc-provider": "9.11.1",
    "@types/pg": "8.21.0",
    "@types/qrcode": "1.5.6",
    "@types/yargs": "17.0.35",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blendsdk/porta-identity.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
