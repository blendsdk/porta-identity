{
  "name": "@portaidentity/cli",
  "version": "1.7.1",
  "description": "Standalone CLI for the Porta Identity Platform",
  "type": "module",
  "bin": {
    "porta": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "../../node_modules/@typescript/native/bin/tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "../../node_modules/@typescript/native/bin/tsc --noEmit",
    "verify": "yarn lint && yarn typecheck && yarn test && yarn build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@portaidentity/sdk": "1.7.1",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "jose": "^6.2.8",
    "open": "^11.0.0",
    "yaml": "^2.9.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/yargs": "^17.0.35",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blendsdk/porta-identity.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
