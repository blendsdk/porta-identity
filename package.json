{
  "name": "@portaidentity/monorepo",
  "version": "1.6.2",
  "description": "Monorepo for the Porta Identity server, SDK, and CLI",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2",
    "yarn": ">=1.22.22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "kill": "fuser -k 3000/tcp 2>/dev/null || true",
    "dev": "yarn kill && tsx watch packages/server/src/index.ts",
    "dev:server": "yarn kill && tsx watch packages/server/src/index.ts",
    "start": "node packages/server/dist/index.js",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:all": "yarn workspace @portaidentity/server test:all && yarn test:sdk && yarn test:cli",
    "test:unit": "yarn workspace @portaidentity/server test:unit",
    "test:integration": "yarn workspace @portaidentity/server test:integration",
    "test:e2e": "yarn workspace @portaidentity/server test:e2e",
    "test:pentest": "yarn workspace @portaidentity/server test:pentest",
    "test:ui": "yarn workspace @portaidentity/server test:ui",
    "test:ui:debug": "yarn workspace @portaidentity/server test:ui:debug",
    "test:watch": "yarn workspace @portaidentity/server test:watch",
    "test:coverage": "yarn workspace @portaidentity/server test:coverage",
    "test:structure": "node --test repo-tests/monorepo/*.test.mjs",
    "verify": "yarn test:structure && turbo run verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "build:server": "yarn workspace @portaidentity/server build",
    "build:sdk": "yarn workspace @portaidentity/sdk build",
    "build:cli": "yarn workspace @portaidentity/cli build",
    "build:packages": "yarn build:server && yarn build:sdk && yarn build:cli",
    "test:server": "yarn workspace @portaidentity/server test",
    "test:sdk": "yarn workspace @portaidentity/sdk test",
    "test:cli": "yarn workspace @portaidentity/cli test",
    "test:packages": "yarn test:server && yarn test:sdk && yarn test:cli",
    "verify:server": "yarn workspace @portaidentity/server verify",
    "verify:sdk": "yarn workspace @portaidentity/sdk verify",
    "verify:cli": "yarn workspace @portaidentity/cli verify",
    "migrate": "node-pg-migrate up --migrations-dir packages/server/migrations --migration-file-language sql",
    "migrate:rollback": "node-pg-migrate down --migrations-dir packages/server/migrations --migration-file-language sql --count 1",
    "migrate:status": "node-pg-migrate status --migrations-dir packages/server/migrations --migration-file-language sql",
    "migrate:create": "node-pg-migrate create --migrations-dir packages/server/migrations --migration-file-language sql",
    "porta": "tsx packages/server/src/cli/index.ts",
    "cli": "tsx packages/cli/src/index.ts --insecure",
    "playground": "bash scripts/run-playground.sh",
    "playground:stop": "bash scripts/run-playground-stop.sh",
    "playground:reset": "bash scripts/run-playground-reset.sh",
    "harness:start": "bash test-harness/scripts/start.sh",
    "harness:stop": "bash test-harness/scripts/stop.sh",
    "harness:test": "bash test-harness/scripts/test.sh",
    "provision:smoke": "tsx scripts/provision-smoke-test.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deps:check": "ncu --root --workspaces -x \"@portaidentity/*\"",
    "deps:update": "ncu -u --root --workspaces -x \"@portaidentity/*\" && rm -rf node_modules yarn.lock && yarn install && yarn verify"
  },
  "devDependencies": {
    "@koa/router": "^15.7.0",
    "@playwright/test": "1.62.1",
    "@types/koa": "^3.0.3",
    "@types/koa-session": "^6.4.5",
    "@types/koa-static": "^4.0.4",
    "@types/koa__router": "^12.0.5",
    "dotenv": "17.4.2",
    "koa": "^3.2.1",
    "koa-session": "^7.0.2",
    "koa-static": "^5.0.0",
    "mermaid": "11.16.1",
    "npm-check-updates": "23.0.2",
    "oidc-client-ts": "3.5.0",
    "openid-client": "^6.8.4",
    "prettier": "3.9.6",
    "sirv-cli": "^3.0.1",
    "tsx": "4.23.11",
    "turbo": "^2.10.9",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
