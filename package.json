{
  "name": "@portaidentity/monorepo",
  "version": "1.7.3",
  "description": "Monorepo for the Porta Identity server, SDK, and CLI",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2",
    "yarn": ">=1.22.22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch packages/server/src/index.ts",
    "start": "node packages/server/dist/index.js",
    "build": "turbo run build",
    "typecheck": "node_modules/@typescript/native/bin/tsc --project test-harness/tsconfig.assurance.json --noEmit && turbo run typecheck",
    "lint": "eslint --config test-harness/eslint.config.js 'test-harness/assurance/**/*.ts' && turbo run lint",
    "lint:fix": "eslint --config test-harness/eslint.config.js 'test-harness/assurance/**/*.ts' --fix && turbo run lint:fix",
    "test": "turbo run test",
    "test:all": "yarn workspace @portaidentity/server test:all && yarn workspace @portaidentity/sdk test && yarn workspace @portaidentity/cli test",
    "test:unit": "yarn workspace @portaidentity/server test:unit",
    "test:integration": "yarn workspace @portaidentity/server test:integration",
    "test:e2e": "yarn workspace @portaidentity/server test:e2e",
    "test:pentest": "yarn workspace @portaidentity/server test:pentest",
    "test:ui": "yarn workspace @portaidentity/server test:ui",
    "test:ui:debug": "yarn workspace @portaidentity/server test:ui:debug",
    "test:watch": "yarn workspace @portaidentity/server test:watch",
    "test:coverage": "yarn workspace @portaidentity/server test:coverage",
    "test:structure": "node --test repo-tests/monorepo/*.test.mjs",
    "verify": "yarn test:structure && turbo run verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "migrate": "node-pg-migrate up --migrations-dir packages/server/migrations --migration-file-language sql",
    "migrate:rollback": "node-pg-migrate down --migrations-dir packages/server/migrations --migration-file-language sql --count 1",
    "migrate:status": "node-pg-migrate status --migrations-dir packages/server/migrations --migration-file-language sql",
    "migrate:create": "node-pg-migrate create --migrations-dir packages/server/migrations --migration-file-language sql",
    "porta": "tsx packages/server/src/cli/index.ts",
    "cli": "tsx packages/cli/src/index.ts --insecure",
    "harness:start": "bash test-harness/scripts/start.sh",
    "harness:stop": "bash test-harness/scripts/stop.sh",
    "harness:test": "bash test-harness/scripts/test.sh",
    "assurance:test": "tsx test-harness/assurance/scripts/run-command.ts test",
    "assurance:red": "tsx test-harness/assurance/scripts/run-command.ts red",
    "assurance:baseline": "tsx test-harness/assurance/scripts/run-command.ts baseline",
    "assurance:validate": "tsx test-harness/assurance/scripts/run-command.ts validate",
    "assurance:harness": "tsx test-harness/assurance/scripts/run-command.ts harness",
    "assurance:coverage": "tsx test-harness/assurance/scripts/run-command.ts coverage",
    "assurance:fault": "tsx test-harness/assurance/scripts/run-command.ts fault",
    "assurance:mutation": "tsx test-harness/assurance/scripts/run-command.ts mutation",
    "assurance:control-check": "tsx test-harness/assurance/scripts/run-command.ts control-check",
    "assurance:compat": "tsx test-harness/assurance/scripts/run-command.ts compat",
    "assurance:report": "tsx test-harness/assurance/scripts/run-command.ts report",
    "assurance:stability": "tsx test-harness/assurance/scripts/run-command.ts stability",
    "assurance:all": "tsx test-harness/assurance/scripts/run-command.ts all",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deps:check": "ncu --root --workspaces -x \"@portaidentity/*\"",
    "deps:update": "ncu -u --root --workspaces -x \"@portaidentity/*\" && rm -rf node_modules yarn.lock && yarn install && yarn verify",
    "release:prepare": "lockstep version --type auto --no-git-commit && node scripts/sync-versions.js",
    "release:preflight": "node scripts/release-preflight.js && node scripts/sync-versions.js --check",
    "release:publish": "yarn release:preflight && npm_config_registry=https://registry.npmjs.org lockstep publish --tag latest --provenance"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "1.0.2",
    "@blendsdk/lockstep": "1.3.0",
    "@eslint/js": "10.0.1",
    "@koa/router": "^15.7.0",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/koa": "^3.0.3",
    "@types/koa-session": "^6.4.5",
    "@types/koa-static": "^4.0.4",
    "@types/koa__router": "^12.0.5",
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "acorn": "8.18.0",
    "ast-v8-to-istanbul": "1.0.5",
    "dotenv": "17.4.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "koa": "^3.2.1",
    "koa-session": "^7.0.2",
    "koa-static": "^5.0.0",
    "mermaid": "11.16.1",
    "npm": "11.15.0",
    "npm-check-updates": "23.0.2",
    "oidc-client-ts": "3.5.0",
    "openid-client": "^6.8.4",
    "prettier": "3.9.6",
    "sirv-cli": "^3.0.1",
    "tsx": "4.23.11",
    "turbo": "^2.10.9",
    "typescript-eslint": "8.66.0",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
