# ──────────────────────────────────────────────
# Porta Docker Build Context Exclusions
# Keeps the build context small and fast
#
# NOTE: This file must be at the project root
# (the build context), not inside docker/.
# ──────────────────────────────────────────────

# Version control
.git/
.gitignore

# Dependencies (rebuilt inside Docker)
node_modules/

# Build output (rebuilt inside Docker)
dist/

# pnpm local metadata (rebuilt inside Docker)
.pnpm-store/
pnpm-debug.log*

# Tests and generated reports not needed by either image
tests/
packages/*/tests/
/coverage/
packages/*/coverage/
.turbo/
test-results/
playwright-report/
release-artifacts/
work/

# Internal planning, requirements, and maintainer documentation
codeops/
techdocs/
repo-tests/

# Harness runtime state not needed by the image build
test-harness/assurance/
test-harness/bff/
test-harness/consumers/
test-harness/fixtures/
test-harness/spa/
test-harness/tests/
test-harness/.assurance-results/
test-harness/.assurance-runtime/

# Documentation
docs/

# Planning & requirements (internal)
plans/
requirements/

# Scripts (dev tooling only)
scripts/

# CI/CD workflows
.github/

# IDE & editor files
.vscode/
.idea/
*.swp
*.swo

# Environment files (secrets — never bake into image)
.env
.env.*
!.env.docker

# Docker files not needed in build context
docker/docker-compose.yml
docker/docker-compose.prod.yml
docker/init-test-db.sql
docker/.dockerignore

# Config files not needed at runtime
Makefile
.editorconfig
.prettierrc
# Keep local auth tokens and machine-specific npm settings out of the build context.
.npmrc
eslint.config.js
tsconfig.eslint.json
vitest.config.ts

# Misc
LICENSE
*.md
!README.md
