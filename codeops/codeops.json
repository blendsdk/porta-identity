{
  "schema": 1,
  "mode": "strict",
  "artifacts": {"layout": "nested", "root": "codeops"},
  "quality": {
    "independentReview": true,
    "minimumReviewers": 1,
    "stopOnMajorFinding": true
  },
  "routing": {
    "roles": {
      "oidc-provider-reviewer": {
        "effort": "high",
        "reasoning": "max",
        "sandbox": "read-only"
      }
    }
  },
  "metrics": {"enabled": false}
}
